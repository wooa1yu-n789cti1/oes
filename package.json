{
  "name": "oes",
  "version": "0.0.1",
  "description": "Vertical enterprise application system for sanitary ceramic manufacturing, covering mold management, MES, WMS, CRM, SRM, finance, tenant identity, permissions, PDA workflows, and auditability.",
  "author": "OES contributors",
  "private": false,
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.33.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/imkgsam/oes.git"
  },
  "bugs": {
    "url": "https://github.com/imkgsam/oes/issues"
  },
  "homepage": "https://github.com/imkgsam/oes#readme",
  "keywords": [
    "sanitary-ceramic",
    "manufacturing",
    "mes",
    "wms",
    "crm",
    "srm",
    "erp",
    "mold-management",
    "pda",
    "multi-tenant",
    "nestjs",
    "ddd",
    "grpc"
  ],
  "workspaces": [
    "app/browser-extension",
    "src/services/*",
    "src/services/auxiliary/*",
    "src/services/business/*",
    "src/services/system/*",
    "src/site-runtime/*",
    "src/site-runtime/external-site-template/runtime",
    "src/site-runtime/external-site-template/storefront",
    "src/site-runtime/meilong-ceramics-site/runtime",
    "src/site-runtime/meilong-ceramics-site/storefront",
    "src/common"
  ],
  "scripts": {
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint": "pnpm -r run lint",
    "prisma:generate:all": "node scripts/local/generate-prisma-clients.mjs",
    "proto:gen": "buf generate --template src/common/src/contracts/buf.gen.yaml src/common/src/contracts",
    "proto:regen": "rimraf src/common/src/generated && pnpm run proto:gen",
    "proto:lint": "buf lint src/common/src/contracts",
    "proto:breaking": "node scripts/local/proto-breaking.mjs",
    "proto:format": "buf format -w src/common/src/contracts",
    "clear:nm": "rimraf node_modules",
    "clear:nm:all": "pnpm -r run clear:nm && pnpm clear:nm",
    "clear:build": "rimraf dist && rimraf tsconfig.tsbuildinfo",
    "clear:build:all": "pnpm -r run clear:build && pnpm clear:build",
    "clear": "npm run clear:build:all && npm run clear:nm:all",
    "docker:infra:up": "pnpm db:up",
    "docker:infra:down": "pnpm db:rollback",
    "local:trusted-runtime:check": "pnpm runtime:status --",
    "local:trusted-runtime:prepare": "pnpm runtime:plan -- --profile DEV --test-class integration --owner auth-service",
    "local:trusted-runtime:up": "node scripts/local-runtime/launcher.mjs dev --scope system",
    "local:trusted-runtime:status": "pnpm runtime:status --",
    "local:trusted-runtime:down": "pnpm runtime:reconcile --",
    "observability:config": "pnpm runtime:plan -- --profile LOCAL_INTEGRATION --test-class integration --owner api-gateway --capabilities trace-specific",
    "observability:smoke": "pnpm runtime:a0 -- --scenario otel",
    "gateway:apisix:smoke": "pnpm common:build && pnpm --filter api-gateway build && node scripts/local/gateway-apisix-smoke.mjs",
    "gateway:events:config": "pnpm runtime:plan -- --profile LOCAL_INTEGRATION --test-class integration --owners collaboration-service,notification-service --capabilities events,network-trust",
    "gateway:events:smoke": "pnpm runtime:a0 -- --scenario events",
    "common:build": "pnpm --filter @oes/common build",
    "backend:system:db:sync": "node scripts/local-runtime/launcher.mjs migrate",
    "backend:business:db:sync": "node scripts/local-runtime/launcher.mjs migrate",
    "backend:db:sync": "node scripts/local-runtime/launcher.mjs migrate",
    "backend:foundation:sync": "node scripts/local-runtime/launcher.mjs foundation-seed",
    "seed:system-admin": "node scripts/local/seed-system-admin.mjs",
    "seed:public-business-card-acceptance": "node scripts/local/public-business-card-acceptance-seed.mjs",
    "seed:collaboration-task-p1": "pnpm --filter collaboration-service seed:p1",
    "collaboration-task:smoke": "node scripts/local/collaboration-task-p1-smoke.mjs",
    "reset:sysadmin": "node scripts/local/reset-to-system-admin.mjs --apply",
    "backend:preflight": "pnpm runtime:plan -- --profile DEV --test-class integration --owner permission-service",
    "backend:dev-service": "node scripts/local-runtime/launcher.mjs dev",
    "pms": "node scripts/local-runtime/launcher.mjs dev --owners permission-service",
    "ids": "node scripts/local-runtime/launcher.mjs dev --owners identity-service",
    "hrs": "node scripts/local-runtime/launcher.mjs dev --owners hr-service",
    "ats": "node scripts/local-runtime/launcher.mjs dev --owners auth-service",
    "cos": "node scripts/local-runtime/launcher.mjs dev --owners collaboration-service",
    "ass": "node scripts/local-runtime/launcher.mjs dev --owners asset-service",
    "ims": "node scripts/local-runtime/launcher.mjs dev --owners item-master-service",
    "nts": "node scripts/local-runtime/launcher.mjs dev --owners notification-service",
    "pes": "node scripts/local-runtime/launcher.mjs dev --owners public-entry-service",
    "pts": "node scripts/local-runtime/launcher.mjs dev --owners party-service",
    "site": "node scripts/local-runtime/launcher.mjs dev --owners site-service",
    "tos": "node scripts/local-runtime/launcher.mjs dev --owners tenant-org-service",
    "tds": "node scripts/local-runtime/launcher.mjs dev --owners terminal-device-service",
    "bas": "node scripts/local-runtime/launcher.mjs dev --owners browser-activity-service",
    "sales": "node scripts/local-runtime/launcher.mjs dev --owners sales-service",
    "crm": "node scripts/local-runtime/launcher.mjs dev --owners crm-service",
    "srm": "node scripts/local-runtime/launcher.mjs dev --owners srm-service",
    "finance": "node scripts/local-runtime/launcher.mjs dev --owners finance-service",
    "procurement": "node scripts/local-runtime/launcher.mjs dev --owners procurement-service",
    "wms": "node scripts/local-runtime/launcher.mjs dev --owners wms-service",
    "mes": "node scripts/local-runtime/launcher.mjs dev --owners mes-service",
    "sales:smoke": "pnpm --filter sales-service smoke",
    "crm:smoke": "pnpm --filter crm-service smoke",
    "srm:smoke": "pnpm --filter srm-service smoke",
    "finance:smoke": "pnpm --filter finance-service smoke",
    "procurement:smoke": "pnpm --filter procurement-service smoke",
    "public-entry:smoke": "pnpm --filter public-entry-service smoke",
    "wms:smoke": "pnpm --filter wms-service smoke",
    "mes:smoke": "pnpm --filter mes-service smoke",
    "bff": "node scripts/local-runtime/launcher.mjs dev --owners api-gateway",
    "backend:system": "node scripts/local-runtime/launcher.mjs dev --scope system",
    "backend:business": "node scripts/local-runtime/launcher.mjs dev --scope business",
    "backend": "node scripts/local-runtime/launcher.mjs dev --scope full",
    "dev:system": "node scripts/local-runtime/launcher.mjs dev --scope system",
    "dev:business": "node scripts/local-runtime/launcher.mjs dev --scope business",
    "dev:all": "node scripts/local-runtime/launcher.mjs dev --scope full",
    "dev": "node scripts/local-runtime/launcher.mjs dev --scope full",
    "web": "pnpm --dir app/web --filter @oes/tenant-web dev",
    "site:dev": "pnpm meilong:dev",
    "meilong:backend": "pnpm --dir src/site-runtime/meilong-ceramics-site dev:backend",
    "meilong:frontend": "pnpm --dir src/site-runtime/meilong-ceramics-site dev:frontend",
    "meilong:dev": "concurrently -k -n meilong-backend,meilong-frontend \"pnpm meilong:backend\" \"pnpm meilong:frontend\"",
    "meilong": "pnpm meilong:dev",
    "collaboration-runtime:typecheck": "tsc -p scripts/collaboration-runtime/tsconfig.json --noEmit",
    "collaboration-runtime:test": "node --experimental-strip-types --test scripts/collaboration-runtime/src/__tests__/*.unit.spec.ts",
    "collaboration-runtime:static": "node scripts/collaboration-runtime/test/static/ci.static.check.mjs",
    "collaboration-runtime:check": "pnpm collaboration-runtime:typecheck && pnpm collaboration-runtime:test && pnpm collaboration-runtime:static",
    "env:bootstrap": "pnpm runtime:plan -- --profile DEV --test-class integration --owner permission-service",
    "env:ensure": "pnpm runtime:plan -- --profile DEV --test-class integration --owner permission-service",
    "env:check": "pnpm runtime:plan -- --profile DEV --test-class integration --owner permission-service",
    "generated:all": "pnpm proto:gen && pnpm prisma:generate:all",
    "workspace:check": "node scripts/local/reproducible-build-check.mjs",
    "build:backend": "pnpm generated:all && pnpm exec tsc -b tsconfig.json",
    "build:prepared": "pnpm workspace:check && pnpm exec tsc -b tsconfig.json && pnpm build:site-runtime",
    "build:site-runtime": "pnpm --filter @oes/site-runtime-kit build && pnpm --filter @oes/external-site-template-runtime build && pnpm --filter @oes/meilong-ceramics-site-runtime build && pnpm --filter @oes/external-site-template-storefront build && pnpm --filter @oes/meilong-ceramics-site-storefront build",
    "build": "pnpm workspace:check && pnpm build:backend && pnpm build:site-runtime",
    "test:reproducible-build": "node --test scripts/local/src/reproducible-build-check.unit.spec.mjs",
    "db:config": "pnpm runtime:plan -- --profile DEV --test-class integration --owner permission-service",
    "db:up": "pnpm runtime:start -- --profile DEV --test-class integration --owners permission-service,identity-service,hr-service,auth-service,collaboration-service,asset-service,item-master-service,notification-service,public-entry-service,party-service,site-service,tenant-org-service,terminal-device-service,browser-activity-service,sales-service,crm-service,srm-service,finance-service,procurement-service,wms-service,mes-service,api-gateway --task-key developer_dev",
    "db:health": "pnpm runtime:status --",
    "db:migrate": "node scripts/local-runtime/launcher.mjs migrate",
    "db:seed": "node scripts/local-runtime/launcher.mjs foundation-seed",
    "db:verify": "pnpm runtime:status --",
    "db:rollback": "pnpm runtime:reconcile --",
    "db:cycle": "pnpm db:up",
    "identity:machine-inventory": "node scripts/local/machine-workload-inventory.mjs",
    "test:unit": "pnpm test:run -- --type unit",
    "test:ci": "pnpm test:full",
    "test:discover": "node scripts/test-infrastructure/src/discover.mjs",
    "test:plan": "node scripts/test-infrastructure/src/change-plan.mjs",
    "check:static": "node scripts/test-infrastructure/src/static-check.mjs",
    "test:run": "node scripts/test-infrastructure/src/run.mjs",
    "test:component": "pnpm test:run -- --type component",
    "test:contract": "pnpm test:run -- --type contract",
    "test:integration": "pnpm test:run -- --type integration",
    "test:journey": "pnpm test:run -- --type journey",
    "test:full": "pnpm --dir app/web install --frozen-lockfile && pnpm --dir app/pda install --frozen-lockfile && pnpm check:static && pnpm generated:all && pnpm workspace:check && node scripts/test-infrastructure/src/package-scripts.mjs --kind static --mode FULL && node scripts/test-infrastructure/src/package-scripts.mjs --kind build --mode FULL && pnpm test:unit && pnpm test:component && pnpm test:contract && pnpm test:integration && pnpm test:journey",
    "runtime": "node scripts/local-runtime/launcher.mjs",
    "runtime:plan": "node scripts/local-runtime/launcher.mjs plan",
    "runtime:start": "node scripts/local-runtime/launcher.mjs start",
    "runtime:run": "node scripts/local-runtime/launcher.mjs run",
    "runtime:status": "node scripts/local-runtime/launcher.mjs status",
    "runtime:reconcile": "node scripts/local-runtime/launcher.mjs reconcile",
    "runtime:seed:system-admin": "node scripts/local-runtime/launcher.mjs system-admin-seed",
    "runtime:dev:backup": "node scripts/local-runtime/launcher.mjs dev-backup",
    "runtime:dev:restore": "node scripts/local-runtime/launcher.mjs dev-restore",
    "runtime:state:inventory": "node scripts/local-runtime/launcher.mjs state-inventory",
    "runtime:state:plan": "node scripts/local-runtime/launcher.mjs state-plan",
    "runtime:state:stage": "node scripts/local-runtime/launcher.mjs state-stage",
    "runtime:state:activate": "node scripts/local-runtime/launcher.mjs state-activate",
    "runtime:state:recover": "node scripts/local-runtime/launcher.mjs state-recover",
    "runtime:state:rollback": "node scripts/local-runtime/launcher.mjs state-rollback",
    "runtime:operator:status": "node scripts/local-runtime/launcher.mjs operator-status",
    "runtime:a0": "node scripts/local-runtime/a0.mjs",
    "runtime:legacy:inventory": "node scripts/local-runtime/launcher.mjs legacy-inventory",
    "runtime:legacy:plan": "node scripts/local-runtime/launcher.mjs legacy-plan",
    "runtime:legacy:backup": "node scripts/local-runtime/launcher.mjs legacy-backup",
    "runtime:legacy:apply": "node scripts/local-runtime/launcher.mjs legacy-apply",
    "runtime:legacy:residue": "node scripts/local-runtime/launcher.mjs legacy-residue",
    "local-runtime:test": "node --test scripts/local-runtime/src/__tests__/*.unit.spec.mjs scripts/local/src/seed-system-admin.unit.spec.mjs scripts/test-infrastructure/src/integration-runtime.unit.spec.mjs",
    "local-runtime:contract": "node --test scripts/local-runtime/test/*.contract.spec.mjs",
    "local-runtime:static": "node scripts/local-runtime/test/static.check.mjs",
    "local-runtime:check": "pnpm local-runtime:test && pnpm local-runtime:contract && pnpm local-runtime:static",
    "db:fixture": "node scripts/local-runtime/launcher.mjs fixture"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.4",
    "@grpc/proto-loader": "^0.8.0",
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.1.3",
    "@nestjs/cqrs": "^11.0.3",
    "@nestjs/microservices": "^11.1.3",
    "@nestjs/platform-express": "^11.0.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.80.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.222.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-metrics": "^2.11.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "axios": "^1.18.0",
    "axios-retry": "^4.5.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "ioredis": "^5.6.1",
    "lodash": "^4.17.21",
    "nacos": "^2.6.1",
    "otplib": "^12.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@prisma/client": "6.4.1",
    "@swc/cli": "^0.6.0",
    "@swc/core": "^1.10.7",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.7",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^8.38.0",
    "@typescript-eslint/parser": "^8.38.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "grpc-tools": "^1.13.1",
    "grpc_tools_node_protoc_ts": "^5.3.3",
    "jest": "^29.7.0",
    "playwright": "1.58.2",
    "prettier": "^3.4.2",
    "prisma": "6.4.1",
    "protobufjs": "^8.6.6",
    "rimraf": "^6.1.3",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "ts-proto": "^2.11.1",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.20.0"
  },
  "pnpm": {
    "overrides": {
      "@nestjs/common": "11.1.16",
      "@nestjs/core": "11.1.16"
    }
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
