{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oes.local/schemas/collaboration-runtime/coordination-lifecycle-roster-authority-v2.json",
  "title": "OES V2 CO lifecycle creation roster authority",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "authorityFingerprint",
    "coordinationKey",
    "coordinationOwnerTaskId",
    "transitionId",
    "coordinationCleanupAuthorizationFingerprint",
    "source",
    "createdRoster"
  ],
  "properties": {
    "schemaVersion": { "const": 2 },
    "kind": { "const": "OES_COORDINATION_LIFECYCLE_ROSTER_AUTHORITY" },
    "authorityFingerprint": { "$ref": "#/$defs/sha256" },
    "coordinationKey": { "$ref": "#/$defs/key" },
    "coordinationOwnerTaskId": { "$ref": "#/$defs/token" },
    "transitionId": { "$ref": "#/$defs/token" },
    "coordinationCleanupAuthorizationFingerprint": { "$ref": "#/$defs/sha256" },
    "source": { "enum": ["TASK_NATIVE_CREATION_RECEIPTS", "EXECUTION_NATIVE_CREATION_RECEIPTS"] },
    "createdRoster": {
      "type": "array",
      "minItems": 4,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/task" }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "key": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "token": { "type": "string", "minLength": 1 },
    "taskKind": { "enum": ["BOUNDED_HELPER", "RV", "DO", "CO"] },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["taskId", "taskKind", "ownerTaskId", "creationReceiptFingerprint"],
      "properties": {
        "taskId": { "$ref": "#/$defs/token" },
        "taskKind": { "$ref": "#/$defs/taskKind" },
        "ownerTaskId": { "type": ["string", "null"], "minLength": 1 },
        "creationReceiptFingerprint": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
