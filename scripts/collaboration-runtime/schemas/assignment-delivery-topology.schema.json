{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oes.local/schemas/assignment-delivery-topology.schema.json",
  "title": "OES bounded Delivery topology decision",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "enum": ["OES_DELIVERY_TOPOLOGY_REQUEST", "OES_DELIVERY_TOPOLOGY_DECISION"] },
    "requestFingerprint": { "$ref": "#/$defs/fingerprint" },
    "coordinationOwnerTaskId": { "$ref": "#/$defs/token" },
    "deliveryOwnerTaskId": { "$ref": "#/$defs/token" },
    "coordinationKey": { "$ref": "#/$defs/deliveryKey" },
    "deliveryKey": { "$ref": "#/$defs/deliveryKey" },
    "transitionId": { "$ref": "#/$defs/token" },
    "stateVersion": { "type": "integer", "minimum": 1 },
    "scopeFingerprint": { "$ref": "#/$defs/fingerprint" },
    "rootAuthorizationFingerprint": { "$ref": "#/$defs/fingerprint" },
    "coordinationWipAuthority": { "$ref": "#/$defs/coordinationWipAuthority" },
    "oldTopology": { "$ref": "#/$defs/wip" },
    "delegationCeiling": { "$ref": "#/$defs/ceiling" },
    "retainedWriteSet": { "$ref": "#/$defs/writeSet" },
    "currentResources": { "$ref": "#/$defs/resources" },
    "completedSlices": {
      "type": "array",
      "items": { "$ref": "#/$defs/completedSlice" },
      "uniqueItems": true
    },
    "proposedSiblings": {
      "type": "array",
      "items": { "$ref": "#/$defs/sibling" },
      "uniqueItems": true
    },
    "invalidationConditions": { "$ref": "#/$defs/invalidationConditions" },
    "decisionFingerprint": { "$ref": "#/$defs/fingerprint" },
    "decision": { "enum": ["DELIVERY_TOPOLOGY_REQUIRED", "ATOMIC_CONTINUATION"] },
    "request": { "$ref": "#/$defs/request" },
    "newTopology": { "$ref": "#/$defs/wip" },
    "nextLegalAction": {
      "enum": [
        "RETURN_DELIVERY_TOPOLOGY_REQUIRED_TO_OWNER",
        "RETURN_DELIVERY_TOPOLOGY_REQUIRED_TO_DA",
        "CONTINUE_ORIGINAL_DELIVERY_WITH_BOUNDED_HELPERS"
      ]
    },
    "reason": { "type": "string", "minLength": 1 }
  },
  "allOf": [
    {
      "if": { "properties": { "kind": { "const": "OES_DELIVERY_TOPOLOGY_REQUEST" } } },
      "then": { "$ref": "#/$defs/request" }
    },
    {
      "if": { "properties": { "kind": { "const": "OES_DELIVERY_TOPOLOGY_DECISION" } } },
      "then": { "$ref": "#/$defs/decisionRecord" }
    }
  ],
  "$defs": {
    "fingerprint": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "gitSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "deliveryKey": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "token": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$" },
    "stringList": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "writeRange": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._@-]+(?:/[A-Za-z0-9._@-]+)*(?:/\\*\\*)?$",
      "not": { "pattern": "(?:^|/)\\.\\.?(?:/|$)" }
    },
    "writeSet": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/writeRange" }
    },
    "nonEmptyWriteSet": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/writeRange" }
    },
    "ceiling": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxActiveDeliveryOwners",
        "maxActiveBoundedHelpersPerDelivery",
        "maxActiveReviewVerifiersPerDelivery"
      ],
      "properties": {
        "maxActiveDeliveryOwners": { "enum": [1, 2, 3] },
        "maxActiveBoundedHelpersPerDelivery": { "enum": [1, 2, 3] },
        "maxActiveReviewVerifiersPerDelivery": { "const": 1 }
      }
    },
    "deliveryWip": {
      "type": "object",
      "additionalProperties": false,
      "required": ["deliveryKey", "activeBoundedHelpers", "activeReviewVerifiers"],
      "properties": {
        "deliveryKey": { "$ref": "#/$defs/deliveryKey" },
        "activeBoundedHelpers": { "type": "integer", "minimum": 0 },
        "activeReviewVerifiers": { "type": "integer", "minimum": 0 }
      }
    },
    "wip": {
      "type": "object",
      "additionalProperties": false,
      "required": ["activeDeliveryOwners", "deliveries"],
      "properties": {
        "activeDeliveryOwners": { "type": "integer", "minimum": 0 },
        "deliveries": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/deliveryWip" }
        }
      }
    },
    "coordinationWipAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "kind",
        "authorityFingerprint",
        "coordinationOwnerTaskId",
        "coordinationKey",
        "transitionId",
        "coordinationStateVersion",
        "coordinationStateFingerprint",
        "activeDeliveryOwners",
        "activeDeliveryKeys",
        "ceiling"
      ],
      "properties": {
        "schemaVersion": { "const": 1 },
        "kind": { "const": "OES_COORDINATION_WIP_AUTHORITY_BINDING" },
        "authorityFingerprint": { "$ref": "#/$defs/fingerprint" },
        "coordinationOwnerTaskId": { "$ref": "#/$defs/token" },
        "coordinationKey": { "$ref": "#/$defs/deliveryKey" },
        "transitionId": { "$ref": "#/$defs/token" },
        "coordinationStateVersion": { "type": "integer", "minimum": 1 },
        "coordinationStateFingerprint": { "$ref": "#/$defs/fingerprint" },
        "activeDeliveryOwners": { "enum": [1, 2, 3] },
        "activeDeliveryKeys": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/deliveryKey" }
        },
        "ceiling": { "$ref": "#/$defs/ceiling" }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ownerRef", "ownerClone", "taskTemp", "deliveryPackagePath"],
      "properties": {
        "ownerRef": { "type": "string", "minLength": 1 },
        "ownerClone": { "type": "string", "minLength": 1 },
        "taskTemp": { "type": "string", "minLength": 1 },
        "deliveryPackagePath": { "type": "string", "pattern": "^/" }
      }
    },
    "completedSlice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sliceId", "commitSha", "candidateSha", "evidenceFingerprints"],
      "properties": {
        "sliceId": { "$ref": "#/$defs/token" },
        "commitSha": { "$ref": "#/$defs/gitSha" },
        "candidateSha": { "type": ["string", "null"], "pattern": "^[0-9a-f]{40}$" },
        "evidenceFingerprints": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/fingerprint" }
        }
      }
    },
    "proof": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "independentCandidate",
        "independentReviewVerification",
        "independentPullRequest",
        "safeIndependentMainMerge"
      ],
      "properties": {
        "independentCandidate": { "type": "boolean" },
        "independentReviewVerification": { "type": "boolean" },
        "independentPullRequest": { "type": "boolean" },
        "safeIndependentMainMerge": { "type": "boolean" }
      }
    },
    "sibling": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deliveryKey",
        "objective",
        "scope",
        "protectedScope",
        "writeSet",
        "dependencies",
        "acceptance",
        "requiredCapabilityFingerprint",
        "independenceProof",
        "scopeFingerprint"
      ],
      "properties": {
        "deliveryKey": { "$ref": "#/$defs/deliveryKey" },
        "objective": { "type": "string", "minLength": 1 },
        "scope": { "$ref": "#/$defs/stringList" },
        "protectedScope": { "$ref": "#/$defs/stringList" },
        "writeSet": { "$ref": "#/$defs/nonEmptyWriteSet" },
        "dependencies": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "acceptance": { "$ref": "#/$defs/stringList" },
        "requiredCapabilityFingerprint": { "$ref": "#/$defs/fingerprint" },
        "independenceProof": { "$ref": "#/$defs/proof" },
        "scopeFingerprint": { "$ref": "#/$defs/fingerprint" }
      }
    },
    "invalidationConditions": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "uniqueItems": true,
      "items": {
        "enum": [
          "OWNER_OR_PARENT_CHANGED",
          "COORDINATION_OR_DELIVERY_KEY_CHANGED",
          "TRANSITION_OR_STATE_VERSION_CHANGED",
          "SCOPE_OR_PROTECTED_SCOPE_CHANGED",
          "ROOT_AUTHORIZATION_CHANGED",
          "TOPOLOGY_OR_CEILING_CHANGED",
          "SIBLING_BINDING_CHANGED",
          "COMPLETED_WORK_OR_EVIDENCE_CHANGED",
          "RESOURCE_BINDING_CHANGED"
        ]
      },
      "allOf": [
        { "contains": { "const": "OWNER_OR_PARENT_CHANGED" } },
        { "contains": { "const": "COORDINATION_OR_DELIVERY_KEY_CHANGED" } },
        { "contains": { "const": "TRANSITION_OR_STATE_VERSION_CHANGED" } },
        { "contains": { "const": "SCOPE_OR_PROTECTED_SCOPE_CHANGED" } },
        { "contains": { "const": "ROOT_AUTHORIZATION_CHANGED" } },
        { "contains": { "const": "TOPOLOGY_OR_CEILING_CHANGED" } },
        { "contains": { "const": "SIBLING_BINDING_CHANGED" } },
        { "contains": { "const": "COMPLETED_WORK_OR_EVIDENCE_CHANGED" } },
        { "contains": { "const": "RESOURCE_BINDING_CHANGED" } }
      ]
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "kind",
        "requestFingerprint",
        "coordinationOwnerTaskId",
        "deliveryOwnerTaskId",
        "coordinationKey",
        "deliveryKey",
        "transitionId",
        "stateVersion",
        "scopeFingerprint",
        "rootAuthorizationFingerprint",
        "coordinationWipAuthority",
        "oldTopology",
        "delegationCeiling",
        "retainedWriteSet",
        "currentResources",
        "completedSlices",
        "proposedSiblings",
        "invalidationConditions"
      ],
      "properties": {
        "schemaVersion": { "const": 1 },
        "kind": { "const": "OES_DELIVERY_TOPOLOGY_REQUEST" },
        "requestFingerprint": { "$ref": "#/$defs/fingerprint" },
        "coordinationOwnerTaskId": { "$ref": "#/$defs/token" },
        "deliveryOwnerTaskId": { "$ref": "#/$defs/token" },
        "coordinationKey": { "$ref": "#/$defs/deliveryKey" },
        "deliveryKey": { "$ref": "#/$defs/deliveryKey" },
        "transitionId": { "$ref": "#/$defs/token" },
        "stateVersion": { "type": "integer", "minimum": 1 },
        "scopeFingerprint": { "$ref": "#/$defs/fingerprint" },
        "rootAuthorizationFingerprint": { "$ref": "#/$defs/fingerprint" },
        "coordinationWipAuthority": { "$ref": "#/$defs/coordinationWipAuthority" },
        "oldTopology": { "$ref": "#/$defs/wip" },
        "delegationCeiling": { "$ref": "#/$defs/ceiling" },
        "retainedWriteSet": { "$ref": "#/$defs/writeSet" },
        "currentResources": { "$ref": "#/$defs/resources" },
        "completedSlices": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/completedSlice" }
        },
        "proposedSiblings": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/sibling" }
        },
        "invalidationConditions": { "$ref": "#/$defs/invalidationConditions" }
      }
    },
    "decisionRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "kind",
        "decisionFingerprint",
        "decision",
        "request",
        "newTopology",
        "nextLegalAction",
        "reason"
      ],
      "properties": {
        "schemaVersion": { "const": 1 },
        "kind": { "const": "OES_DELIVERY_TOPOLOGY_DECISION" },
        "decisionFingerprint": { "$ref": "#/$defs/fingerprint" },
        "decision": { "enum": ["DELIVERY_TOPOLOGY_REQUIRED", "ATOMIC_CONTINUATION"] },
        "request": { "$ref": "#/$defs/request" },
        "newTopology": { "$ref": "#/$defs/wip" },
        "nextLegalAction": {
          "enum": [
            "RETURN_DELIVERY_TOPOLOGY_REQUIRED_TO_OWNER",
            "RETURN_DELIVERY_TOPOLOGY_REQUIRED_TO_DA",
            "CONTINUE_ORIGINAL_DELIVERY_WITH_BOUNDED_HELPERS"
          ]
        },
        "reason": { "type": "string", "minLength": 1 }
      }
    }
  }
}
