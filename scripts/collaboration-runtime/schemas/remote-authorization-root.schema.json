{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oes.local/schemas/collaboration-runtime/remote-authorization-root-v2.json",
  "title": "OES remote authorization root",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "recordFingerprint",
    "status",
    "issuerTaskId",
    "owner",
    "expectedState",
    "stateVersion",
    "transitionId",
    "decisionConfirmation",
    "rootConfirmationFingerprint",
    "scopeFingerprint",
    "truthBaseline",
    "repositoryRoot",
    "repositorySlug",
    "artifactRoot",
    "allowedActions"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "kind": {
      "const": "OES_REMOTE_AUTHORIZATION_ROOT"
    },
    "recordFingerprint": {
      "$ref": "#/$defs/sha256"
    },
    "status": {
      "const": "ACTIVE"
    },
    "issuerTaskId": {
      "type": "string",
      "minLength": 1
    },
    "owner": {
      "$ref": "#/$defs/owner"
    },
    "expectedState": {
      "type": "string",
      "minLength": 1
    },
    "stateVersion": {
      "type": "integer",
      "minimum": 1
    },
    "transitionId": {
      "type": "string",
      "minLength": 1
    },
    "decisionConfirmation": { "$ref": "#/$defs/reference" },
    "rootConfirmationFingerprint": {
      "$ref": "#/$defs/sha256"
    },
    "scopeFingerprint": {
      "$ref": "#/$defs/sha256"
    },
    "truthBaseline": {
      "$ref": "#/$defs/gitSha"
    },
    "repositoryRoot": {
      "type": "string",
      "pattern": "^/"
    },
    "repositorySlug": {
      "type": "string",
      "pattern": "^[^/]+/[^/]+$"
    },
    "artifactRoot": {
      "type": "string",
      "pattern": "^/"
    },
    "allowedActions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/action"
      }
    },
    "mergeAuthorizationFingerprint": {
      "$ref": "#/$defs/sha256"
    },
    "cleanupAuthorizationFingerprint": {
      "$ref": "#/$defs/sha256"
    },
    "resourceTopologyVersion": {
      "const": "owner-exclusive-v2"
    },
    "ownerResourceBinding": {
      "$ref": "#/$defs/reference"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "gitSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "action": {
      "enum": ["preflight", "publish-pr", "verify-pr", "merge-pr", "verify-main"]
    },
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "taskId"],
      "properties": {
        "role": {
          "enum": ["DO", "UD", "DO", "CO"]
        },
        "taskId": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "fingerprint"],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^/"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "fingerprint": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": ["resourceTopologyVersion"]
      },
      "then": {
        "required": ["ownerResourceBinding"]
      }
    },
    {
      "if": {
        "required": ["ownerResourceBinding"]
      },
      "then": {
        "required": ["resourceTopologyVersion"]
      }
    }
  ]
}
