{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oes.local/schemas/collaboration-runtime/review-session-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "transport",
    "deliveryKey",
    "ownerTaskId",
    "reviewerAgentId",
    "candidateGenerations",
    "state",
    "sessionFingerprint"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "OES_VISIBLE_RV_SUBAGENT_SESSION" },
    "transport": { "const": "VISIBLE_SUBAGENT" },
    "deliveryKey": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "ownerTaskId": { "type": "string", "minLength": 1 },
    "reviewerAgentId": { "type": "string", "minLength": 1 },
    "candidateGenerations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$" }
    },
    "state": { "enum": ["ACTIVE", "TERMINAL"] },
    "sessionFingerprint": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
