{
  "name": "notification-service",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "pnpm run test:typecheck && pnpm run test:unit && pnpm run test:component && pnpm run test:contract && pnpm run test:integration",
    "test:typecheck": "tsc -p tsconfig.spec.json --noEmit",
    "build": "tsc -b",
    "dev:build": "tsc -b -w --preserveWatchOutput",
    "dev:start": "wait-on dist/main.js ../../../common/dist/index.js && nodemon --watch dist --watch ../../../common/dist --ext js,json --signal SIGTERM dist/main.js",
    "dev": "concurrently -k -n build,run \"pnpm run dev:build\" \"pnpm run dev:start\"",
    "start": "node dist/main.js",
    "prisma:generate": "npx prisma generate --schema=./prisma/schema.prisma",
    "clear:build": "rimraf dist && rimraf tsconfig.tsbuildinfo",
    "clear:nm": "rimraf node_modules",
    "clear": "npm run clear:build && npm run clear:nm",
    "rebuild": "npm run clear && npm install && npm run build",
    "prisma:migrate:deploy": "prisma migrate deploy --schema=./prisma/schema.prisma",
    "test:unit": "jest --config jest.config.js --runInBand --passWithNoTests --testPathPattern='\\.unit\\.spec\\.ts$'",
    "test:component": "jest --config jest.config.js --runInBand --passWithNoTests --testPathPattern='\\.component\\.spec\\.ts$'",
    "test:contract": "jest --config jest.config.js --runInBand --passWithNoTests --testPathPattern='\\.contract\\.spec\\.ts$'",
    "test:integration": "pnpm --workspace-root test:run -- --type integration --owner notification-service"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.3",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^12.0.1",
    "@nestjs/cqrs": "^11.0.3",
    "@nestjs/microservices": "^12.0.1",
    "@nestjs/platform-express": "^11.1.3",
    "@oes/common": "workspace:*",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.29.0",
    "@nestjs/cli": "^11.0.7",
    "@nestjs/schematics": "^11.0.5",
    "@nestjs/testing": "^11.1.3",
    "@swc/cli": "^0.6.0",
    "@swc/core": "^1.12.6",
    "@types/express": "^5.0.3",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.15.33",
    "concurrently": "^9.2.1",
    "eslint": "^9.29.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-prettier": "^5.5.0",
    "globals": "^16.2.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.6.1",
    "rimraf": "^6.1.3",
    "source-map-support": "^0.5.21",
    "ts-jest": "^29.4.0",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.35.0",
    "wait-on": "^8.0.5"
  }
}
