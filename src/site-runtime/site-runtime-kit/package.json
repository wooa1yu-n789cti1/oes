{
  "name": "@oes/site-runtime-kit",
  "version": "0.1.0",
  "description": "OES external site runtime SDK and lightweight runtime framework.",
  "private": true,
  "license": "UNLICENSED",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit -p tsconfig.tests.json",
    "smoke:local-runtime": "NODE_OPTIONS=--no-warnings=ExperimentalWarning ts-node --project tsconfig.tests.json scripts/local-runtime-smoke.ts",
    "clear:build": "rimraf dist && rimraf tsconfig.tsbuildinfo",
    "test": "pnpm test:unit && pnpm test:component && pnpm test:contract && pnpm test:integration",
    "test:unit": "NODE_OPTIONS=--no-warnings=ExperimentalWarning jest --config jest.config.js --runInBand --testPathPattern='\\.unit\\.spec\\.ts$'",
    "test:component": "NODE_OPTIONS=--no-warnings=ExperimentalWarning jest --config jest.config.js --runInBand --testPathPattern='\\.component\\.spec\\.ts$'",
    "test:contract": "NODE_OPTIONS=--no-warnings=ExperimentalWarning jest --config jest.config.js --runInBand --testPathPattern='\\.contract\\.spec\\.ts$' --passWithNoTests",
    "test:integration": "NODE_OPTIONS=--no-warnings=ExperimentalWarning jest --config jest.config.js --runInBand --testPathPattern='\\.integration\\.spec\\.ts$'"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.0.1",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.7",
    "jest": "^29.7.0",
    "rimraf": "^6.1.3",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  }
}
