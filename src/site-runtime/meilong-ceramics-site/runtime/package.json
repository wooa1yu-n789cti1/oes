{
  "name": "@oes/meilong-ceramics-site-runtime",
  "version": "0.1.0",
  "private": true,
  "description": "NestJS Site Runtime backend for the Meilong Ceramics external site pilot.",
  "license": "UNLICENSED",
  "main": "dist/main.js",
  "types": "dist/main.d.ts",
  "scripts": {
    "build": "tsc -b",
    "dev": "ts-node -r tsconfig-paths/register --project tsconfig.json src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.1.3",
    "@nestjs/platform-express": "^11.0.1",
    "@oes/site-runtime-kit": "workspace:*",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.7",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.8.3"
  }
}
